FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for psycopg2/asyncpg and basic utils
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies first to cache them
COPY pyproject.toml .
RUN pip install --no-cache-dir .

# Copy source code
COPY . .

# Expose port
EXPOSE 8000

# Default command
CMD ["uvicorn", "sage.main:app", "--host", "0.0.0.0", "--port", "8000"]
